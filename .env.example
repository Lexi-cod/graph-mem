GRAPHMEM_NEO4J_URI=bolt://localhost:7687
GRAPHMEM_NEO4J_USER=neo4j
GRAPHMEM_NEO4J_PASSWORD=graphmem-dev

# Decay rate per day (0 = off; dev sweep found no benefit). 0.05 => half-life ~13.9 days.
GRAPHMEM_DECAY_LAMBDA=0.0
# Rerank mix: alpha*similarity + (1-alpha)*decay_score
GRAPHMEM_RETRIEVAL_ALPHA=1.0
GRAPHMEM_RETRIEVAL_K=10
GRAPHMEM_PRUNE_THRESHOLD=0.05

# Local LLM (OpenAI-compatible; Ollama via SSH tunnel)
GRAPHMEM_LLM_BASE_URL=http://localhost:11435/v1
GRAPHMEM_LLM_MODEL=qwen3:14b
# Judge (separate pass; unset = GRAPHMEM_LLM_MODEL). Planned: a ~32B instruct model, 4-bit.
# GRAPHMEM_JUDGE_MODEL=
GRAPHMEM_CONTRADICTION_MODE=rules
